{
  "name": "looot-battlecards",
  "version": "0.1.3",
  "description": "Open-source competitive battlecards: pricing, positioning, news, hiring, tech stack, reviews and ads for each competitor, with a source and date on every claim. Next.js and looot.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo": "NEXT_PUBLIC_DEMO=1 next dev -p 3231",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "cards": "tsx src/cli/index.ts",
    "leak-scan": "bash scripts/leak-scan.sh ."
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
